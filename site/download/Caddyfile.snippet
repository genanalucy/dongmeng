# Add inside each site's existing block. Channel names are site-specific:
# sslip -> debug.json; yszn -> production.json. Never replace unrelated sites.
# The release script atomically switches /opt/dngmeng/downloads/current.
@downloadPage path /download /download/
handle @downloadPage {
	root * /opt/dngmeng/downloads/current
	rewrite * /index.html
	header Cache-Control "no-store"
	header X-Content-Type-Options nosniff
	file_server
}
handle /download/releases.json {
	root * /opt/dngmeng/downloads/current
	rewrite * /releases.json
	header Cache-Control "no-store"
	file_server
}
handle_path /downloads/* {
	root * /opt/dngmeng/downloads/files
	header Content-Type application/vnd.android.package-archive
	header Content-Disposition attachment
	header X-Content-Type-Options nosniff
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}
