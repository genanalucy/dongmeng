47-129-170-16.sslip.io {
	encode zstd gzip

	# Legacy Debug clients do not send a package/channel parameter.
	# Install docs/deployment/ota/debug-v25.json at the path below before reload.
	# Keep the production yszn.nlplayer.org site's update route on Cloud API.
	handle /api/v1/app-update {
		root * /opt/dngmeng/ota
		rewrite * /debug-v25.json
		header Content-Type application/json
		header Cache-Control "no-store"
		file_server
	}

	handle /healthz {
		header Content-Type application/json
		respond "{\"status\":\"edge-ready\"}" 200
	}

	handle /ws/translate {
		reverse_proxy 127.0.0.1:18765
	}

	handle /api/health {
		reverse_proxy 127.0.0.1:18765
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle_path /admin/* {
		root * /opt/dngmeng/admin-web
		try_files {path} /index.html
		file_server
	}

	redir /admin /admin/ 308
	respond 404
}
