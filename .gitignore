.codebase-memory/

# Official Volcengine AST attachments and generated code (local-only; no redistribution license)
agent/.official-ast/
agent/internal/officialastproto/

# Web dependencies and generated artifacts
node_modules/
dist/
*.tsbuildinfo
*.log

# Local environment files; keep examples trackable
.env
.env.*
!.env.example

# Local provider credentials; never commit API-key exports.
api/*.csv

# Python bytecode caches
__pycache__/
*.py[cod]

# Local CodeGraph index
.codegraph/

# Android local/build artifacts; source and Gradle wrapper remain trackable.
android/.gradle/
android/.kotlin/
android/app/build/
android/local.properties
*.apk
